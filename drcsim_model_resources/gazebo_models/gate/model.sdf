<?xml version="1.0"?>
<sdf version="1.4">
  <model name="gate">
    <static>true</static>
    <pose>0 0 2.0 0 0 0</pose>
    <link name="link">
      <collision name="right_collision">
        <pose>0 -2.5 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.2 0.2 4.0</size>
          </box>
        </geometry>
      </collision>

      <collision name="left_collision">
        <pose>0 2.5 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.2 0.2 4.0</size>
          </box>
        </geometry>
      </collision>

      <collision name="top_collision">
        <pose>0 0 2.1 0 0 0</pose>
        <geometry>
          <box>
            <size>0.2 5.2 0.2</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <pose>0 0 -2.0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://gate/meshes/gate.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
          <specular>0.1 0.1 0.1 1.0</specular>
          <pbr>
            <metal>
              <albedo_map>model://gate/materials/textures/gate.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>

    </link>
  </model>
</sdf>
